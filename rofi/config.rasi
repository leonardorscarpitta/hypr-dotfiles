configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "Applications";
    display-run: "Commands";
    display-window: "Windows";
    drun-display-format: "{name}[  <span foreground='#86838d'>{generic}</span>]";
    font: "Intel One Mono 11";
}

@theme "kintsugi"
