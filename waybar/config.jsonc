{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 6,

    "modules-left":   ["custom/logo", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["group/media", "clock"],
    "modules-right":  ["tray", "pulseaudio", "group/resources", "group/net", "custom/nightlight", "custom/power"],

    "group/media": {
        "orientation": "horizontal",
        "modules": ["mpris", "custom/prev", "custom/playpause", "custom/next"]
    },

    "custom/prev": {
        "format": "󰒮",
        "tooltip-format": "Previous",
        "on-click": "playerctl previous"
    },

    "custom/playpause": {
        "format": "󰐎",
        "tooltip-format": "Play / pause",
        "on-click": "playerctl play-pause"
    },

    "custom/next": {
        "format": "󰒭",
        "tooltip-format": "Next",
        "on-click": "playerctl next"
    },

    "group/net": {
        "orientation": "horizontal",
        "modules": ["network#vpn", "network"]
    },

    "custom/logo": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "rofi -show drun"
    },

    "hyprland/workspaces": {
        "format": " ",
        "persistent-workspaces": { "*": 1 },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
    },

    "hyprland/window": {
        "format": "{title}",
        "icon": true,
        "icon-size": 15,
        "max-length": 40,
        "separate-outputs": true
    },

    "clock": {

        "format": "{0:%I:%M %p}  <span color='#86838d'>•</span>  {0:%a %d}",
        "format-alt": "{0:%I:%M %p}  <span color='#86838d'>•</span>  {0:%A, %m/%d/%Y}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months":   "<span color='#e2dfff'><b>{}</b></span>",
                "weekdays": "<span color='#86838d'>{}</span>",
                "today":    "<span color='#131318' background='#c4c0ff'><b>{}</b></span>"
            }
        }
    },

    "mpris": {

        "format":        "<span color='#c4c0ff'>{player_icon}</span>  {title} <span color='#86838d'>•</span> <span color='#86838d'>{artist}</span>",
        "format-paused": "<span color='#86838d'>{player_icon}</span>  <span color='#86838d'>{title}</span> <span color='#46454f'>•</span> <span color='#46454f'>{artist}</span>",
        "format-stopped": "",
        "player-icons": {
            "default":  "󰎇",
            "brave":    "󰗃",
            "chromium": "󰗃",
            "firefox":  "󰈹",
            "spotify":  "󰓇",
            "mpv":      "󱜅"
        },
        "status-icons": { "playing": "󰏤", "paused": "󰐊" },
        "title-len": 15,
        "ellipsis": "…",
        "tooltip-format": "{player} · {status}\n{title}\n{artist}\n{album}",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    "network": {

        "interface": "enp9s0",
        "interval": 5,
        "format-ethernet":     "<span color='#c4c0ff'>󰈀</span>",
        "format-linked":       "<span color='#86838d'>󰈀</span>",
        "format-disconnected": "<span color='#ffb4ab'>󰅛</span>",
        "tooltip-format": "{ifname} · {ipaddr}/{cidr} via {gwaddr}\n󰁅 {bandwidthDownBytes}   󰁝 {bandwidthUpBytes}",
        "tooltip-format-disconnected": "enp9s0 · cable unplugged or link down",
        "on-click": "nm-connection-editor"
    },

    "network#vpn": {

        "interface": "wg0",
        "interval": 5,
        "format":              "<span color='#c4c0ff'>󰌆</span>",
        "format-ethernet":     "<span color='#c4c0ff'>󰌆</span>",
        "format-linked":       "<span color='#c4c0ff'>󰌆</span>",
        "format-disconnected": "<span color='#ffb4ab'>󰌆</span>",
        "tooltip-format-disconnected": "WireGuard · wg0 is down",
        "tooltip-format": "WireGuard · {ifname} · {ipaddr}/{cidr}\n󰁅 {bandwidthDownBytes}   󰁝 {bandwidthUpBytes}"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8,
        "icons": {
            "discord_status_icon_0": "discord-tray",
            "discord_status_icon_1": "discord-tray",
            "TelegramDesktop": "telegram-panel",
            "gpu-screen-recorder-ui": "record-desktop-indicator"
        }
    },

    "pulseaudio": {

        "format": "<span color='#c4c0ff'>{icon}</span>  {volume}%",
        "format-muted": "<span color='#86838d'>󰝟</span>  <span color='#86838d'>muted</span>",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "tooltip-format": "{desc} · {volume}%",
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "custom/nightlight": {
        "exec": "~/.config/waybar/scripts/nightlight.sh",
        "return-type": "json",
        "interval": 30,
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/nightlight.sh toggle"
    },

    "group/resources": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory", "custom/gpu"]
    },

    "cpu": {
        "format": "<span color='#c4c0ff'>󰓅</span>  {usage}%",
        "interval": 3,
        "states": { "warning": 70, "critical": 90 },
        "tooltip-format": "CPU · {usage}%",
        "on-click": "kitty -e btop"
    },

    "memory": {
        "format": "<span color='#c4c0ff'>󰍛</span>  {percentage}%",
        "interval": 3,
        "states": { "warning": 70, "critical": 90 },
        "tooltip-format": "RAM · {used:0.1f} / {total:0.1f} GiB",
        "on-click": "kitty -e btop"
    },

    "custom/gpu": {
        "format": "<span color='#c4c0ff'>󰢮</span>  {}%",
        "exec": "~/.config/waybar/scripts/gpu.sh",
        "return-type": "json",
        "interval": 3,
        "on-click": "kitty -e btop"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Power menu",
        "on-click": "~/.config/hypr/scripts/powermenu.sh"
    }
}
